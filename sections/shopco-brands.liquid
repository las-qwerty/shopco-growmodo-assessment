{% comment %}
  Shopco - Brand logos marquee
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <div class="shopco-brands" id="section-{{ section.id }}">
    <div class="shopco-page-width">
      <ul class="shopco-brands__list" role="list">
        {%- for block in section.blocks -%}
          {%- capture brand_mark -%}
            {%- if block.settings.logo != blank -%}
              {%- assign logo = block.settings.logo -%}
              <img
                src="{{ logo | image_url: width: 320 }}"
                srcset="{{ logo | image_url: width: 160 }} 160w, {{ logo | image_url: width: 320 }} 320w"
                sizes="160px"
                alt="{{ logo.alt | default: block.settings.brand_name | escape }}"
                width="{{ logo.width }}"
                height="{{ logo.height }}"
                loading="lazy"
                class="shopco-brands__image"
              >
            {%- else -%}
              <span class="shopco-brands__logo">{{ block.settings.brand_name | escape }}</span>
            {%- endif -%}
          {%- endcapture -%}

          <li class="shopco-brands__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="shopco-link" href="{{ block.settings.link }}">{{ brand_mark }}</a>
            {%- else -%}
              {{ brand_mark }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Shopco Brands",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "default": "VERSACE",
          "label": "Brand name",
          "info": "Used as the wordmark when no logo image is uploaded, and as the logo's alt text."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shopco Brands",
      "category": "Shopco",
      "block_order": ["brand-1", "brand-2", "brand-3", "brand-4", "brand-5"],
      "blocks": {
        "brand-1": {
          "type": "brand",
          "settings": {
            "brand_name": "VERSACE"
          }
        },
        "brand-2": {
          "type": "brand",
          "settings": {
            "brand_name": "ZARA"
          }
        },
        "brand-3": {
          "type": "brand",
          "settings": {
            "brand_name": "GUCCI"
          }
        },
        "brand-4": {
          "type": "brand",
          "settings": {
            "brand_name": "PRADA"
          }
        },
        "brand-5": {
          "type": "brand",
          "settings": {
            "brand_name": "CALVIN KLEIN"
          }
        }
      }
    }
  ]
}
{% endschema %}
