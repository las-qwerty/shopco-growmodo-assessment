{% comment %}
  Shopco - Hero section
  Based on the Figma E-commerce Website Template (Freebie) by Hamza Naeem
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  assign has_stats = false
  if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank
    assign has_stats = true
  endif
-%}

<section class="shopco-hero" id="section-{{ section.id }}">
  <div class="shopco-page-width shopco-hero__inner">
    <div class="shopco-hero__content">
      <h1 class="shopco-hero__title">{{ section.settings.heading | escape }}</h1>

      {%- if section.settings.text != blank -%}
        <p class="shopco-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a
          href="{{ section.settings.button_link }}"
          class="shopco-button shopco-button--primary shopco-hero__cta"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}

      {%- if has_stats -%}
        <ul class="shopco-hero__stats">
          {%- for i in (1..3) -%}
            {%- liquid
              assign value_key = 'stat_' | append: i | append: '_value'
              assign label_key = 'stat_' | append: i | append: '_label'
              assign value = section.settings[value_key]
              assign label = section.settings[label_key]
            -%}
            {%- if value != blank -%}
              <li class="shopco-hero__stat">
                <span class="shopco-hero__stat-value">{{ value | escape }}</span>
                {%- if label != blank -%}
                  <span class="shopco-hero__stat-label">{{ label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="shopco-hero__media">
      {%- if image != blank -%}
        <img
          srcset="
            {%- if image.width >= 375 -%}{{ image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if image.width >= 750 -%}{{ image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if image.width >= 1100 -%}{{ image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {{ image | image_url: width: image.width }} {{ image.width }}w
          "
          src="{{ image | image_url: width: 800 }}"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ image.alt | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          loading="eager"
          fetchpriority="high"
          class="shopco-hero__image"
        >
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'shopco-hero__image' }}
      {%- endif -%}

      {%- if section.settings.show_sparkles -%}
        <span class="shopco-hero__sparkle shopco-hero__sparkle--lg" aria-hidden="true">
          <svg viewBox="0 0 104 104" fill="currentColor" focusable="false">
            <path d="M52 0c0 28.7 23.3 52 52 52-28.7 0-52 23.3-52 52 0-28.7-23.3-52-52-52 28.7 0 52-23.3 52-52Z"/>
          </svg>
        </span>
        <span class="shopco-hero__sparkle shopco-hero__sparkle--sm" aria-hidden="true">
          <svg viewBox="0 0 104 104" fill="currentColor" focusable="false">
            <path d="M52 0c0 28.7 23.3 52 52 52-28.7 0-52 23.3-52 52 0-28.7-23.3-52-52-52 28.7 0 52-23.3 52-52Z"/>
          </svg>
        </span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shopco Hero",
  "tag": "section",
  "class": "shopco-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "FIND CLOTHES THAT MATCHES YOUR STYLE",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "default": "Browse through our diverse range of meticulously crafted garments, designed to bring out your individuality and cater to your sense of style.",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop Now",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "default": "/collections/all",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "checkbox",
      "id": "show_sparkles",
      "default": true,
      "label": "Show decorative sparkles",
      "info": "Matches the star accents in the reference design."
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "default": "200+",
      "label": "Stat 1 value"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "default": "International Brands",
      "label": "Stat 1 label"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "default": "2,000+",
      "label": "Stat 2 value"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "default": "High-Quality Products",
      "label": "Stat 2 label"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "default": "30,000+",
      "label": "Stat 3 value"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "default": "Happy Customers",
      "label": "Stat 3 label"
    }
  ],
  "presets": [
    {
      "name": "Shopco Hero",
      "category": "Shopco"
    }
  ]
}
{% endschema %}
