{% comment %}
  Shopco - Hero section
  Based on the Figma E-commerce Website Template (Freebie) by Hamza Naeem
{% endcomment %}

{%- liquid
  assign has_stats = false
  if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank
    assign has_stats = true
  endif

  assign bg_desktop = section.settings.background_image_desktop
  assign bg_mobile = section.settings.background_image_mobile
  assign has_background = false
  if bg_desktop != blank or bg_mobile != blank
    assign has_background = true
  endif

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  assign section_width_class = 'shopco-hero--width-page'
  if section.settings.section_width == 'full'
    assign section_width_class = 'shopco-hero--width-full'
  elsif section.settings.section_width == 'custom'
    assign section_width_class = 'shopco-hero--width-custom'
  endif

  case section.settings.content_alignment
    when 'center'
      assign content_align_items = 'center'
    when 'right'
      assign content_align_items = 'flex-end'
    else
      assign content_align_items = 'flex-start'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hero-bg-color: {{ section.settings.background_color }};
    --hero-text-color: {{ section.settings.text_color }};
    --hero-min-height-mobile: {% if section.settings.section_min_height_mobile > 0 %}{{ section.settings.section_min_height_mobile }}px{% else %}auto{% endif %};
    --hero-min-height-desktop: {% if section.settings.section_min_height_desktop > 0 %}{{ section.settings.section_min_height_desktop }}px{% else %}auto{% endif %};
    --hero-content-align-items: {{ content_align_items }};
    --hero-content-text-align: {{ section.settings.content_alignment }};
    --hero-content-max-width: {{ section.settings.content_max_width }}px;
    --hero-content-gap: {{ section.settings.content_gap }}px;
    --hero-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --hero-custom-max-width: {{ section.settings.section_max_width }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --hero-padding-top: {{ section.settings.padding_top }}px;
      --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} {
          {%- if block.settings.text_color != blank -%}
            color: {{ block.settings.text_color }};
          {%- endif -%}
          {%- if block.settings.text_align != blank -%}
            text-align: {{ block.settings.text_align }};
          {%- endif -%}
          {%- if block.settings.text_transform != blank -%}
            text-transform: {{ block.settings.text_transform }};
          {%- endif -%}
          font-family: {% if block.settings.font_family == 'display' %}var(--shopco-font-display){% else %}var(--shopco-font-body){% endif %};
          font-size: {{ block.settings.font_size_mobile }}rem;
          font-weight: {{ block.settings.font_weight }};
          line-height: {{ block.settings.line_height }};
          {%- if block.settings.letter_spacing != 0 -%}
            letter-spacing: {{ block.settings.letter_spacing }}em;
          {%- endif -%}
        }
        @media screen and (min-width: 750px) {
          #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} {
            font-size: {{ block.settings.font_size_desktop }}rem;
          }
        }
      {%- when 'text' -%}
        #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} {
          {%- if block.settings.text_color != blank -%}
            color: {{ block.settings.text_color }};
          {%- endif -%}
          {%- if block.settings.text_align != blank -%}
            text-align: {{ block.settings.text_align }};
          {%- endif -%}
          {%- if block.settings.text_transform != blank -%}
            text-transform: {{ block.settings.text_transform }};
          {%- endif -%}
          font-family: {% if block.settings.font_family == 'display' %}var(--shopco-font-display){% else %}var(--shopco-font-body){% endif %};
          font-size: {{ block.settings.font_size_mobile }}rem;
          font-weight: {{ block.settings.font_weight }};
          line-height: {{ block.settings.line_height }};
          {%- if block.settings.letter_spacing != 0 -%}
            letter-spacing: {{ block.settings.letter_spacing }}em;
          {%- endif -%}
          {%- if block.settings.max_width > 0 -%}
            max-width: {{ block.settings.max_width }}px;
          {%- endif -%}
        }
        @media screen and (min-width: 750px) {
          #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} {
            font-size: {{ block.settings.font_size_desktop }}rem;
          }
        }
      {%- when 'button' -%}
        #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} .shopco-hero__button {
          {%- if block.settings.background_color != blank -%}
            background-color: {{ block.settings.background_color }};
          {%- endif -%}
          {%- if block.settings.text_color != blank -%}
            color: {{ block.settings.text_color }};
          {%- endif -%}
          {%- if block.settings.border_color != blank -%}
            border-color: {{ block.settings.border_color }};
          {%- endif -%}
          font-size: {{ block.settings.font_size_mobile }}rem;
          font-weight: {{ block.settings.font_weight }};
          border-radius: {{ block.settings.border_radius }}px;
          padding: {{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;
        }
        @media screen and (min-width: 750px) {
          #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} .shopco-hero__button {
            font-size: {{ block.settings.font_size_desktop }}rem;
          }
        }
      {%- when 'group_start' -%}
        {%- case block.settings.text_align -%}
          {%- when 'center' -%}
            {%- assign group_align = 'center' -%}
            {%- assign group_text_align = 'center' -%}
          {%- when 'right' -%}
            {%- assign group_align = 'flex-end' -%}
            {%- assign group_text_align = 'right' -%}
          {%- else -%}
            {%- assign group_align = 'flex-start' -%}
            {%- assign group_text_align = 'left' -%}
        {%- endcase -%}
        #ShopcoHeroBlock-{{ section.id }}-{{ block.id }} {
          --group-align: {{ group_align }};
          --group-justify: {{ group_align }};
          --group-text-align: {{ group_text_align }};
          --group-gap: {{ block.settings.gap }}px;
          --group-bg: {{ block.settings.background_color }};
          --group-text: {{ block.settings.text_color }};
          --group-radius: {{ block.settings.border_radius }}px;
          --group-padding: {{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;
          --group-max-width: {% if block.settings.max_width > 0 %}{{ block.settings.max_width }}px{% else %}none{% endif %};
        }
      {%- when 'group_end' -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endstyle -%}

<section class="shopco-hero {{ section_width_class }}{% unless has_image %} shopco-hero--no-media{% endunless %}" id="section-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- if has_background -%}
    <picture class="shopco-hero__background" aria-hidden="true">
      {%- if bg_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ bg_mobile | image_url: width: 750 }} 1x, {{ bg_mobile | image_url: width: 1500 }} 2x"
        >
      {%- endif -%}
      {%- if bg_desktop != blank -%}
        <img
          src="{{ bg_desktop | image_url: width: 2000 }}"
          srcset="{{ bg_desktop | image_url: width: 1500 }} 1500w, {{ bg_desktop | image_url: width: 2000 }} 2000w, {{ bg_desktop | image_url: width: 2500 }} 2500w"
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          class="shopco-hero__background-img"
          width="{{ bg_desktop.width }}"
          height="{{ bg_desktop.height }}"
        >
      {%- else -%}
        <img
          src="{{ bg_mobile | image_url: width: 1500 }}"
          srcset="{{ bg_mobile | image_url: width: 750 }} 750w, {{ bg_mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          class="shopco-hero__background-img"
          width="{{ bg_mobile.width }}"
          height="{{ bg_mobile.height }}"
        >
      {%- endif -%}
    </picture>
  {%- endif -%}

  <div class="shopco-hero__inner">
    <div class="shopco-hero__content">
            {%- if section.blocks.size > 0 -%}
        {%- assign in_group = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'group_start' -%}
            {%- if in_group -%}</div>{%- endif -%}
            {%- assign in_group = true -%}
            <div class="shopco-hero__block shopco-hero__group shopco-hero__group--{{ block.settings.layout }}" id="ShopcoHeroBlock-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
            {%- continue -%}
          {%- elsif block.type == 'group_end' -%}
            {%- if in_group -%}</div>{%- endif -%}
            {%- assign in_group = false -%}
            {%- continue -%}
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- if block.settings.text != blank -%}
                <{{ block.settings.html_tag }} class="shopco-hero__block shopco-hero__block--heading" id="ShopcoHeroBlock-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text | newline_to_br }}
                </{{ block.settings.html_tag }}>
              {%- endif -%}
            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="shopco-hero__block shopco-hero__block--text" id="ShopcoHeroBlock-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </div>
              {%- endif -%}
            {%- when 'button' -%}
              {%- if block.settings.label != blank and block.settings.link != blank -%}
                <div class="shopco-hero__block shopco-hero__block--button shopco-hero__block--button-{{ block.settings.alignment }}" id="ShopcoHeroBlock-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  <a
                    href="{{ block.settings.link }}"
                    class="shopco-hero__button{% if block.settings.width == 'full' %} shopco-hero__button--full{% endif %}{% if block.settings.style != 'primary' %} shopco-hero__button--{{ block.settings.style }}{% endif %}"
                  >
                    {{ block.settings.label | escape }}
                  </a>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if in_group -%}</div>{%- endif -%}
      {%- else -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="shopco-hero__block shopco-hero__block--heading shopco-hero__title">
            {{ section.settings.heading | newline_to_br }}
          </h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="shopco-hero__block shopco-hero__block--text shopco-hero__text">
            {{ section.settings.text | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="shopco-hero__button shopco-hero__button--primary shopco-hero__cta">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      {%- endif -%}{%- if has_stats -%}
        <ul class="shopco-hero__stats">
          {%- for i in (1..3) -%}
            {%- liquid
              assign value_key = 'stat_' | append: i | append: '_value'
              assign label_key = 'stat_' | append: i | append: '_label'
              assign value = section.settings[value_key]
              assign label = section.settings[label_key]
            -%}
            {%- if value != blank -%}
              <li class="shopco-hero__stat">
                <span class="shopco-hero__stat-value">{{ value | escape }}</span>
                {%- if label != blank -%}
                  <span class="shopco-hero__stat-label">{{ label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if has_image -%}
      <div class="shopco-hero__media">
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 1x, {{ section.settings.image_mobile | image_url: width: 1500 }} 2x"
            >
          {%- endif -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="
              {%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {{ section.settings.image | image_url: width: section.settings.image.width }} {{ section.settings.image.width }}w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="eager"
            fetchpriority="high"
            class="shopco-hero__image"
          >
        </picture>

        {%- if section.settings.show_sparkles -%}
          <span class="shopco-hero__sparkle shopco-hero__sparkle--lg" aria-hidden="true">
            <svg viewBox="0 0 104 104" fill="currentColor" focusable="false">
              <path d="M52 0c0 28.7 23.3 52 52 52-28.7 0-52 23.3-52 52 0-28.7-23.3-52-52-52 28.7 0 52-23.3 52-52Z"/>
            </svg>
          </span>
          <span class="shopco-hero__sparkle shopco-hero__sparkle--sm" aria-hidden="true">
            <svg viewBox="0 0 104 104" fill="currentColor" focusable="false">
              <path d="M52 0c0 28.7 23.3 52 52 52-28.7 0-52 23.3-52 52 0-28.7-23.3-52-52-52 28.7 0 52-23.3 52-52Z"/>
            </svg>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}{
  "name": "Shopco Hero",
  "tag": "section",
  "class": "shopco-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Default content (used when no blocks are added)"
    },
    {
      "type": "textarea",
      "id": "heading",
      "default": "FIND CLOTHES\nTHAT MATCHES\nYOUR STYLE",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "default": "Browse through our diverse range of meticulously crafted garments, designed to bring out your individuality and cater to your sense of style.",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop Now",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "default": "/collections/all",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero image (mobile)"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#f2f0f1",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#000000",
      "label": "Text color"
    },
    {
      "type": "checkbox",
      "id": "show_sparkles",
      "default": true,
      "label": "Show decorative sparkles"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 600,
      "label": "Content max width"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Content gap"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Page width (1400px)"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 720,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1400,
      "label": "Custom section max width"
    },
    {
      "type": "range",
      "id": "section_min_height_mobile",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 0,
      "label": "Minimum height (mobile)",
      "info": "Set to 0 for auto height."
    },
    {
      "type": "range",
      "id": "section_min_height_desktop",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 0,
      "label": "Minimum height (desktop)",
      "info": "Set to 0 for auto height."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64,
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "default": "200+",
      "label": "Stat 1 value"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "default": "International Brands",
      "label": "Stat 1 label"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "default": "2,000+",
      "label": "Stat 2 value"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "default": "High-Quality Products",
      "label": "Stat 2 label"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "default": "30,000+",
      "label": "Stat 3 value"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "default": "Happy Customers",
      "label": "Stat 3 label"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Heading text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "html_tag",
          "label": "HTML tag",
          "default": "h1",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "p",
              "label": "Paragraph"
            }
          ]
        },
        {
          "type": "select",
          "id": "font_family",
          "label": "Font family",
          "default": "display",
          "options": [
            {
              "value": "display",
              "label": "Display"
            },
            {
              "value": "body",
              "label": "Body"
            }
          ]
        },
        {
          "type": "range",
          "id": "font_size_desktop",
          "min": 1,
          "max": 10,
          "step": 0.1,
          "unit": "rem",
          "default": 5.6,
          "label": "Font size (desktop)"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "min": 1,
          "max": 10,
          "step": 0.1,
          "unit": "rem",
          "default": 3.6,
          "label": "Font size (mobile)"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "700",
          "options": [
            {
              "value": "100",
              "label": "100"
            },
            {
              "value": "200",
              "label": "200"
            },
            {
              "value": "300",
              "label": "300"
            },
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            },
            {
              "value": "800",
              "label": "800"
            },
            {
              "value": "900",
              "label": "900"
            }
          ]
        },
        {
          "type": "range",
          "id": "line_height",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.1,
          "label": "Line height"
        },
        {
          "type": "number",
          "id": "letter_spacing",
          "default": 0,
          "label": "Letter spacing",
          "placeholder": "e.g. 0.05"
        },
        {
          "type": "select",
          "id": "text_transform",
          "label": "Text transform",
          "default": "uppercase",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ]
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text align",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "color",
