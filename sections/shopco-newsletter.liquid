{% comment %}
  Shopco - Newsletter / stay up-to-date
{% endcomment %}

{%- liquid
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'newsletter.button_label' | t
  endif
  assign input_id = 'ShopcoNewsletterEmail--' | append: section.id
-%}

<div class="shopco-page-width" id="section-{{ section.id }}">
  <div class="shopco-newsletter{% if section.settings.overlap_footer %} shopco-newsletter--overlap{% endif %}">
    <div class="shopco-newsletter__content">
      <h2 class="shopco-newsletter__title">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="shopco-newsletter__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer', class: 'shopco-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="shopco-newsletter__field">
        <label class="visually-hidden-shopco" for="{{ input_id }}">
          {{ 'newsletter.label' | t }}
        </label>
        <span class="shopco-newsletter__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false">
            <rect x="2.5" y="5" width="19" height="14" rx="2"/>
            <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <input
          id="{{ input_id }}"
          type="email"
          name="contact[email]"
          class="shopco-newsletter__input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="ShopcoNewsletterError--{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="ShopcoNewsletterSuccess--{{ section.id }}"
          {% endif %}
          placeholder="{{ 'shopco.newsletter.email_placeholder' | t }}"
          required
        >
      </div>

      <button type="submit" class="shopco-button shopco-newsletter__button" name="commit">
        {{ button_label | escape }}
      </button>

      {%- if form.errors -%}
        <p class="shopco-newsletter__message" id="ShopcoNewsletterError--{{ section.id }}">
          {{ form.errors | default_errors }}
        </p>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p
          class="shopco-newsletter__message"
          id="ShopcoNewsletterSuccess--{{ section.id }}"
          tabindex="-1"
          autofocus
        >
          {{ 'newsletter.success' | t }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Shopco Newsletter",
  "tag": "section",
  "class": "shopco-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "STAY UPTO DATE ABOUT OUR LATEST OFFERS",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "default": "We have clothes that suits your style and which you'll be proud to wear. From women to men.",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Subscribe",
      "label": "Button label"
    },
    {
      "type": "checkbox",
      "id": "overlap_footer",
      "default": false,
      "label": "Overlap the footer",
      "info": "Matches the reference design. Enable once the footer has enough top spacing to sit behind the card."
    }
  ],
  "presets": [
    {
      "name": "Shopco Newsletter",
      "category": "Shopco"
    }
  ]
}
{% endschema %}
