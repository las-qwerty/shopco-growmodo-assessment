{% comment %}
  Shopco - Product grid (New Arrivals / Top Selling)
{% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign show_secondary_image = section.settings.show_secondary_image

  assign has_products = false
  if collection != blank and collection.products.size > 0
    assign has_products = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --shopco-section-padding-top: {{ section.settings.padding_top }}px;
    --shopco-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="shopco-page-width" id="section-{{ section.id }}">
  <h2 class="shopco-product-grid__title">{{ section.settings.title | escape }}</h2>

  {%- if has_products -%}
    <ul class="shopco-product-grid__grid" role="list">
      {%- for product in collection.products limit: products_to_show -%}
        {%- liquid
          assign image = product.featured_image
          assign image_2 = product.images[1]
          assign compare_at = product.compare_at_price
          assign on_sale = false
          if compare_at > product.price
            assign on_sale = true
            assign discount = compare_at | minus: product.price | times: 100.0 | divided_by: compare_at | round
          endif
        -%}
        <li>
          <a href="{{ product.url }}" class="shopco-product-card">
            <div class="shopco-product-card__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 660
                  | image_tag:
                    loading: 'lazy',
                    widths: '330, 660, 990',
                    sizes: '(min-width: 990px) 25vw, (min-width: 590px) 50vw, 62vw',
                    alt: image.alt,
                    class: 'shopco-product-card__primary'
                }}
                {%- if show_secondary_image and image_2 != blank -%}
                  {{
                    image_2
                    | image_url: width: 660
                    | image_tag:
                      loading: 'lazy',
                      widths: '330, 660, 990',
                      sizes: '(min-width: 990px) 25vw, (min-width: 590px) 50vw, 62vw',
                      alt: '',
                      class: 'shopco-product-card__secondary'
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <h3 class="shopco-product-card__title">{{ product.title | escape }}</h3>

            {%- if section.settings.show_rating and product.metafields.reviews.rating.value != blank -%}
              {%- assign rating = product.metafields.reviews.rating.value -%}
              {% render 'shopco-rating',
                rating: rating.rating,
                rating_max: rating.scale_max,
                show_value: true
              %}
            {%- endif -%}

            <p class="shopco-product-card__price">
              <span>{{ product.price | money }}</span>
              {%- if on_sale -%}
                <s class="shopco-product-card__price--compare">{{ compare_at | money }}</s>
                <span class="shopco-product-card__badge">-{{ discount }}%</span>
              {%- endif -%}
              {%- unless product.available -%}
                <span class="shopco-product-card__sold-out">{{ 'products.product.sold_out' | t }}</span>
              {%- endunless -%}
            </p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    {%- comment -%}
      Placeholders are editor-only on purpose: shipping fake products and prices
      to real shoppers when a collection is unset or deleted is worse than an
      empty section.
    {%- endcomment -%}
    <ul class="shopco-product-grid__grid" role="list">
      {%- for i in (1..products_to_show) -%}
        <li>
          <div class="shopco-product-card">
            <div class="shopco-product-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <h3 class="shopco-product-card__title">{{ 'onboarding.product_title' | t }}</h3>
            <p class="shopco-product-card__price">{{ 1999 | money }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if section.settings.show_view_all and collection != blank -%}
    <div class="shopco-product-grid__footer">
      <a
        href="{{ collection.url }}"
        class="shopco-button shopco-button--secondary shopco-product-grid__view-all"
        aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title | escape }}"
      >
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.show_divider -%}
  <hr class="shopco-divider">
{%- endif -%}

{% schema %}
{
  "name": "Shopco Product Grid",
  "tag": "section",
  "class": "shopco-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "NEW ARRIVALS",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show product rating",
      "info": "Requires a product reviews app that writes the reviews.rating metafield."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' button"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Show divider below section"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Shopco Product Grid",
      "category": "Shopco"
    }
  ]
}
{% endschema %}
