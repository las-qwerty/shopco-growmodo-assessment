{% comment %}
  Shopco - Happy customers testimonials
{% endcomment %}

<script src="{{ 'shopco-carousel.js' | asset_url }}" defer="defer"></script>

<div class="shopco-page-width" id="section-{{ section.id }}">
  <shopco-carousel>
    <div class="shopco-testimonials__header">
      <h2 class="shopco-section-title">{{ section.settings.title | escape }}</h2>

      {%- if section.blocks.size > 1 -%}
        <div class="shopco-testimonials__arrows">
          <button
            type="button"
            class="shopco-testimonials__arrow"
            data-shopco-carousel-previous
            aria-controls="ShopcoTestimonials-{{ section.id }}"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <path d="M15 5 8 12l7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="shopco-testimonials__arrow"
            data-shopco-carousel-next
            aria-controls="ShopcoTestimonials-{{ section.id }}"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul
        class="shopco-testimonials__track"
        id="ShopcoTestimonials-{{ section.id }}"
        role="list"
        data-shopco-carousel-track
        tabindex="0"
        aria-label="{{ section.settings.title | escape }}"
      >
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <article class="shopco-testimonial">
              <div class="shopco-testimonial__rating">
                {% render 'shopco-rating', rating: block.settings.rating %}
              </div>
              <h3 class="shopco-testimonial__name">
                {{ block.settings.name | escape }}
                {%- if block.settings.verified -%}
                  <span class="shopco-testimonial__badge" aria-hidden="true">&#10003;</span>
                  <span class="visually-hidden-shopco">{{ 'shopco.testimonials.verified' | t }}</span>
                {%- endif -%}
              </h3>
              <p class="shopco-testimonial__text">{{ block.settings.quote | escape }}</p>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </shopco-carousel>
</div>

{% schema %}
{
  "name": "Shopco Testimonials",
  "tag": "section",
  "class": "shopco-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "OUR HAPPY CUSTOMERS",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "default": "Sarah M.",
          "label": "Customer name"
        },
        {
          "type": "textarea",
          "id": "quote",
          "default": "I'm blown away by the quality and style of the clothes I received from Shop.co.",
          "label": "Quote"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Rating"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "default": true,
          "label": "Verified buyer badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shopco Testimonials",
      "category": "Shopco",
      "block_order": ["testimonial-1", "testimonial-2", "testimonial-3"],
      "blocks": {
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "name": "Sarah M.",
            "quote": "I'm blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece has exceeded my expectations.",
            "rating": 5,
            "verified": true
          }
        },
        "testimonial-2": {
          "type": "testimonial",
          "settings": {
            "name": "James L.",
            "quote": "Finding clothes that align with my personal style used to be a challenge until I discovered Shop.co. The range of options they offer is truly remarkable.",
            "rating": 5,
            "verified": true
          }
        },
        "testimonial-3": {
          "type": "testimonial",
          "settings": {
            "name": "Emily R.",
            "quote": "As someone who's always on the lookout for unique fashion pieces, I'm thrilled to have found Shop.co. The selection is diverse and on-point with the latest trends.",
            "rating": 5,
            "verified": true
          }
        }
      }
    }
  ]
}
{% endschema %}
