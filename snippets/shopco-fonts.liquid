{% comment %}
  Shopco - self-hosted display and body typefaces.

  The reference design uses Integral CF (display/headings) and Satoshi (body).
  Neither is freely licensable, so they are not committed to this repository.

  To activate them, upload the licensed .woff2 files to the theme `assets/`
  folder using exactly these filenames:

    integral-cf-bold.woff2
    satoshi-regular.woff2
    satoshi-medium.woff2
    satoshi-bold.woff2

  Until those files exist the @font-face rules simply fail to resolve and the
  fallback stacks in `shopco.css` take over, so the theme stays usable.
{% endcomment %}

{% comment %}theme-check-disable MissingAsset, AssetUrlNotFound{% endcomment %}
{%- style -%}
  @font-face {
    font-family: 'Integral CF';
    src: url('{{ 'integral-cf-bold.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Satoshi';
    src: url('{{ 'satoshi-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Satoshi';
    src: url('{{ 'satoshi-medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Satoshi';
    src: url('{{ 'satoshi-bold.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
{%- endstyle -%}
{% comment %}theme-check-enable MissingAsset, AssetUrlNotFound{% endcomment %}
