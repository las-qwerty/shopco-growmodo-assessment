{% comment %}
  Shopco - star rating

  Accepts:
  - rating: {Number} Rating value (required)
  - rating_max: {Number} Scale maximum. Default: 5
  - show_value: {Boolean} Render the numeric "4.5/5" label. Default: false

  Usage:
  {% render 'shopco-rating', rating: 4.5, show_value: true %}
{% endcomment %}

{%- liquid
  assign scale = rating_max | default: 5
  assign filled = rating | round
-%}

<div class="shopco-rating">
  <span
    class="shopco-rating__stars"
    role="img"
    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: scale }}"
  >
    {%- for index in (1..scale) -%}
      {%- if index <= filled -%}
        <span aria-hidden="true">&#9733;</span>
      {%- else -%}
        <span class="shopco-rating__star--empty" aria-hidden="true">&#9733;</span>
      {%- endif -%}
    {%- endfor -%}
  </span>
  {%- if show_value -%}
    <span class="shopco-rating__value">
      {{- rating -}}
      <span class="shopco-rating__value-max">/{{ scale }}</span>
    </span>
  {%- endif -%}
</div>
